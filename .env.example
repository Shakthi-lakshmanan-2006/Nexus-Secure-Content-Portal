# APP_URL: The URL where this applet is hosted (auto-injected or custom production URL)
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SUPABASE CONFIGURATION
# 1. Project URL from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"

# 2. Public Anon Key for client-side queries (safe for browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. Service Role Key (SERVER ONLY - NEVER expose to browser!)
# Used for server-side role verification, private storage signing, and admin operations
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 4. Admin allow-list: comma-separated list of emails that automatically receive ADMIN role on login
ADMIN_EMAILS="admin@example.com,sakthilakshman521@gmail.com"

# 5. Session encryption / cookie secret
SESSION_SECRET="super-secret-random-nexus-cookie-key-minimum-32-chars"

# 6. Google Cloud OAuth 2.0 Web Client ID (Optional for live Google One-Tap & Popup on Vercel)
# Obtain from Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=""

